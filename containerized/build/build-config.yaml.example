# OpenAN Platform Image Build Configuration File
# Copy this file to build-config.yaml and modify the configuration

# Image registry configuration
registry:
  url: docker.io          # Image registry address
  namespace: openan       # Image namespace
  tag: latest             # Image tag

# Registry Center configuration
registry-center:
  # Source code source (choose one, priority: source > repository)
  source: ""              # Local source path, e.g.: /path/to/registry-center
  repository: ""          # Git repository address, e.g.: https://github.com/org/registry-center.git
  branch: main            # Git branch (only effective when using repository)

# Orchestration Center configuration
orchestration-center:
  source: ""              # Local source path, e.g.: /path/to/orchestration-center
  repository: ""          # Git repository address
  branch: main            # Git branch

# Workflow Designer configuration
# Note: Workflow Designer is a subdirectory of Orchestration Center
# Defaults to {orchestration-center}/workflow-designer
workflow-designer:
  source: ""              # Local source path (optional, default: {orchestration-center}/workflow-designer)

# Build options
build:
  push: false             # Whether to push to registry after build
  no-cache: false         # Whether to disable build cache
  platforms: "linux/amd64,linux/arm64"  # Target platform architectures

# Example configuration:
# 
# Using local source:
# registry-center:
#   source: /home/user/projects/registry-center
# orchestration-center:
#   source: /home/user/projects/orchestration-center
# workflow-designer:
#   source: /home/user/projects/orchestration-center/workflow-designer  # optional
#
# Using Git repository:
# registry-center:
#   repository: https://github.com/openan/registry-center.git
#   branch: v1.0.0
# orchestration-center:
#   repository: https://github.com/openan/orchestration-center.git
#   branch: main
