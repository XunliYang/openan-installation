# Generate HMAC-SHA256 using the registry SDK token_digest command with the same
# INTEGRATION_TOKEN_HMAC_KEY. Never store the plaintext token in this file.
credential.orchestration.identity=orchestration-service
credential.orchestration.token_hash=
credential.orchestration.role=partner_service
credential.orchestration.enabled=true
# Provision additional vendor_agent/nms_oss callers according to least privilege.
