OC_ADMIN_INITIAL_PASSWORD=
# Public API tokens are obtained by logging in with the web account; no fixed machine token.
# Must match a provisioned registry credential (see token_digest tool).
REGISTRY_ACCESS_TOKEN=
LLM_CHAT_API_KEY=
# Optional model keys: name them in the mounted models.yaml, never inline secrets.
LLM_EMBED_API_KEY=
LLM_RERANK_API_KEY=
# Requires an OC image that supports the RETRIEVAL_* deployment aliases.
RETRIEVAL_VECTOR_ENABLED=false
RETRIEVAL_VECTOR_TOP_K=5
RETRIEVAL_VECTOR_MIN_SCORE=0
RETRIEVAL_VECTOR_RERANK=false
RETRIEVAL_VECTOR_LLM_FINAL=true
RETRIEVAL_VECTOR_STRICT=false
RETRIEVAL_VECTOR_INDEX_FILE=data/vector_index/psop_vectors.json
RETRIEVAL_LLM_THINKING=true
# Optional encrypted registry client key password:
# REGISTRY_CLIENT_KEY_PASSWORD=
