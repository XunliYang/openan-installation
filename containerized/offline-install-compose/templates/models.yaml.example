# Copy separately for each service; all SDK-supported capabilities/providers
# belong here. Secrets live in that service's private runtime env file.
models:
  chat:
    provider: openai_compatible
    model: replace-with-model-id
    url: https://model.example.invalid/v1/chat/completions
    api_key_env: LLM_CHAT_API_KEY
# Add these to the OC file before enabling vector recall/rerank. They are optional
