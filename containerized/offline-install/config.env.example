#
# OpenAN offline installation config.
# Copy to config.env, edit, then run:  scripts/install.sh --config config.env
# Leave a value empty ("") to be prompted interactively.

# --- Cluster -----------------------------------------------------------------
# Target namespace for the OpenAN workload.
K8S_NAMESPACE="openan"

# --- Private registry (in-cluster, deployed by this installer) ---------------
# Set to "true" to deploy an in-cluster registry:2 and push all images to it.
INSTALL_REGISTRY="true"
# Node the registry (and, on fallback storage, postgres) is pinned to.
# Leave empty to use the node where install.sh runs.
REGISTRY_NODE=""
# IP of REGISTRY_NODE reachable by every node (used as <ip>:<nodeport>).
# Leave empty to auto-detect.
REGISTRY_NODE_IP=""
# NodePort exposed by the registry Service.
REGISTRY_NODEPORT="30500"

# --- LoadBalancer (MetalLB) --------------------------------------------------
# Set to "true" to install MetalLB when the cluster is bare-metal.
INSTALL_METALLB="true"
# Routable internal IP range for the MetalLB pool (required when INSTALL_METALLB=true).
# e.g. 192.168.1.200-192.168.1.250
METALLB_POOL=""

# --- Ingress -----------------------------------------------------------------
# Leave empty for IP-based access (http://<LB_IP>/).
INGRESS_HOST=""

# --- Storage (postgres) ------------------------------------------------------
# auto  : use the cluster default StorageClass if present, else fall back to hostPath
# sc    : force a StorageClass (set STORAGE_CLASS)
# hostpath : force a local PV / hostPath pinned to STORAGE_NODE
STORAGE_MODE="auto"
STORAGE_CLASS=""
STORAGE_SIZE="20Gi"
HOSTPATH="/data/openan-postgres"
# Node used by the hostpath / local-PV fallback. Leave empty = node running install.sh.
STORAGE_NODE=""

# --- Database ----------------------------------------------------------------
DB_PASSWORD="openan-db-password"

# --- Application images (build-time pinned, install-time overridable) --------
# Bare image reference WITHOUT registry prefix and WITHOUT arch suffix.
# They are pushed to <REGISTRY_NODE_IP>:<REGISTRY_NODEPORT>/<name>:<tag>.
REGISTRY_CENTER_IMAGE="project-openan/registry-center:v1.0.0"
ORCHESTRATION_CENTER_IMAGE="project-openan/orchestration-center:v1.0.0"
WORKFLOW_DESIGNER_IMAGE="project-openan/workflow-designer:v1.0.0"
# Pinned infrastructure image baked into the bundle (registry-relative path).
POSTGRES_IMAGE="library/postgres:15-alpine"

# --- LLM ---------------------------------------------------------------------
REGISTRY_CHAT_MODEL=""
REGISTRY_CHAT_URL=""
REGISTRY_CHAT_APIKEY=""
ORCH_CHAT_MODEL=""
ORCH_CHAT_URL=""
ORCH_CHAT_APIKEY=""
# Offline installs never validate the LLM by default. Set to "true" to probe it.
LLM_VALIDATE="false"

# --- Optional demo agents server --------------------------------------------
START_AGENTS_SERVER="false"
